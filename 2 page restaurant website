<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- ============================================================
       TASK 4: Meta title & description (ChatGPT-style)
       ============================================================ -->
  <title>Spice &amp; Scoot | India's Happiest Food Delivery Influencer</title>
  <meta name="description"
        content="Join Riya 'Spice' Sharma — India's happiest food delivery influencer — for honest reviews, unboxing fun, favourite dishes, and tasty delivery deals across the country.">
  <meta name="keywords" content="food influencer India, food delivery reviews, food blogger, Spice and Scoot, Riya Sharma">

  <style>
    /* ---------- Global styling ---------- */
    * { box-sizing: border-box; }
    body {
      font-family: 'Segoe UI', Arial, sans-serif;
      margin: 0;
      background-color: #fff8f0;
      color: #222;
      line-height: 1.6;
    }
    a { color: #d84315; }
    a:hover { text-decoration: underline; }

    /* ---------- TASK 3: Semantic navigation bar ---------- */
    nav {
      background-color: #d84315;
      padding: 12px 20px;
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: center;
      justify-content: center;
      position: sticky;
      top: 0;
      z-index: 10;
      box-shadow: 0 2px 8px rgba(0,0,0,0.15);
    }
    nav button {
      background-color: transparent;
      color: white;
      border: 2px solid transparent;
      font-weight: bold;
      font-size: 15px;
      padding: 9px 18px;
      border-radius: 8px;
      cursor: pointer;
      font-family: inherit;
      transition: all 0.2s ease;
    }
    nav button:hover {
      background-color: rgba(255,255,255,0.15);
      border-color: #ffcc80;
    }
    /* aria-current highlights the active page/tab */
    nav button[aria-current="page"] {
      background-color: #ffcc80;
      color: #3e2723;
    }

    /* ---------- Layout ---------- */
    .container {
      max-width: 900px;
      margin: 0 auto;
      padding: 30px 20px;
    }
    /* Hide whichever page isn't active */
    .page { display: none; }
    .page.active { display: block; }

    section {
      background: white;
      padding: 25px;
      border-radius: 12px;
      margin-bottom: 25px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }
    section h2 {
      color: #d84315;
      margin-top: 0;
    }

    /* ---------- Homepage hero ---------- */
    header.hero {
      text-align: center;
      padding: 40px 20px;
      background: linear-gradient(135deg, #ff7043, #ffcc80);
      border-radius: 16px;
      margin-bottom: 30px;
    }
    header.hero h1 {
      margin: 0 0 10px;
      font-size: 2.2rem;
      color: #3e2723;
    }
    header.hero p {
      margin: 0;
      font-size: 1.1rem;
      color: #4e342e;
    }

    /* ---------- Dish grid (homepage) ---------- */
    .dish-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
      margin-top: 15px;
    }
    .dish-card {
      background: #fff3e0;
      border-radius: 10px;
      padding: 15px;
      text-align: center;
    }
    .dish-card img {
      width: 100%;
      height: 140px;
      object-fit: cover;
      border-radius: 8px;
    }
    .dish-card h3 {
      margin: 10px 0 5px;
      color: #3e2723;
    }

    /* ---------- Profile header ---------- */
    .profile-header {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 25px;
    }
    .profile-header img {
      width: 140px;
      height: 140px;
      border-radius: 50%;
      object-fit: cover;
      border: 5px solid #ffcc80;
    }
    .profile-header h1 {
      margin: 0 0 6px;
      color: #3e2723;
    }
    .profile-header p {
      margin: 0;
      color: #5d4037;
    }

    /* ---------- Favourite dishes list ---------- */
    .faves {
      list-style: none;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 12px;
      margin-top: 15px;
    }
    .faves li {
      background: #fff3e0;
      padding: 12px 16px;
      border-radius: 8px;
      border-left: 5px solid #d84315;
    }

    /* ============================================================
       TASK 2: Contact form styling (semantic fieldset + labels)
       ============================================================ */
    form {
      display: flex;
      flex-direction: column;
      gap: 15px;
      margin-top: 10px;
    }
    fieldset {
      border: 1px solid #ffcc80;
      border-radius: 10px;
      padding: 18px;
    }
    legend {
      font-weight: bold;
      color: #d84315;
      padding: 0 8px;
    }
    .form-field {
      display: flex;
      flex-direction: column;
      margin-bottom: 12px;
    }
    .form-field label {
      font-weight: bold;
      margin-bottom: 5px;
      color: #3e2723;
    }
    .form-field input,
    .form-field textarea {
      padding: 10px;
      border: 1px solid #ccc;
      border-radius: 6px;
      font-size: 15px;
      font-family: inherit;
    }
    .form-field input:focus,
    .form-field textarea:focus {
      outline: 3px solid #ffcc80;
      border-color: #d84315;
    }
    button[type="submit"] {
      background-color: #d84315;
      color: white;
      border: none;
      padding: 12px 26px;
      border-radius: 6px;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
      align-self: flex-start;
    }
    button[type="submit"]:hover {
      background-color: #bf360c;
    }

    /* ---------- TASK 5: Keyboard accessibility focus styles ---------- */
    a:focus, button:focus {
      outline: 3px solid #ffcc80;
      outline-offset: 2px;
    }

    /* ---------- Footer ---------- */
    footer {
      text-align: center;
      padding: 20px;
      color: #5d4037;
      font-size: 14px;
      background-color: #fff3e0;
      margin-top: 20px;
    }
  </style>
</head>
<body>

  <!-- ============================================================
       TASK 3: Semantic <nav> with buttons to switch pages.
       aria-current is set on the active button.
       ============================================================ -->
  <nav aria-label="Main Navigation">
    <button id="navHome" onclick="switchPage('home')" aria-current="page">🏠 Home</button>
    <button id="navProfile" onclick="switchPage('profile')">👤 Profile</button>
  </nav>

  <div class="container">

    <!-- ============================================================
         PAGE 1: HOMEPAGE
         ============================================================ -->
    <div id="page-home" class="page active">

      <header class="hero">
        <h1>Welcome to Spice &amp; Scoot! 🛵</h1>
        <p>India's happiest food delivery influencer — honest reviews, big flavors, bigger smiles.</p>
      </header>

      <section aria-labelledby="about-heading">
        <h2 id="about-heading">Who Am I?</h2>
        <p>
          Hi, I'm <strong>Riya "Spice" Sharma</strong> — a food-obsessed content creator from Mumbai.
          I order, film, and review food from every corner of India, from roadside <em>vada pav</em>
          to five-star <em>biryani</em>. My mission? Help you discover your next favourite meal
          without leaving your sofa.
        </p>
      </section>

      <section aria-labelledby="featured-heading">
        <h2 id="featured-heading">This Week's Top Picks 🍽️</h2>
        <div class="dish-grid">

          <article class="dish-card">
            <img src="https://images.unsplash.com/photo-1563379091339-03b21ab4a4f8?w=400"
                 alt="A plate of steaming Hyderabadi chicken biryani with saffron rice and boiled egg">
            <h3>Hyderabadi Biryani</h3>
            <p>Fragrant, spicy, and utterly addictive.</p>
          </article>

          <article class="dish-card">
            <img src="https://images.unsplash.com/photo-1631452180519-c014fe946bc7?w=400"
                 alt="Crispy golden masala dosa served with coconut chutney and sambar">
            <h3>Masala Dosa</h3>
            <p>The South Indian classic that never fails.</p>
          </article>

          <article class="dish-card">
            <img src="https://images.unsplash.com/photo-1601050690597-df0568f70950?w=400"
                 alt="Two pieces of soft gulab jamun soaked in golden sugar syrup">
            <h3>Gulab Jamun</h3>
            <p>Sweet, warm, and melt-in-your-mouth good.</p>
          </article>

        </div>
      </section>

    </div>

    <!-- ============================================================
         PAGE 2: PROFILE
         ============================================================ -->
    <div id="page-profile" class="page">

      <section>
        <div class="profile-header">
          <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=300"
               alt="Portrait photo of Riya Sharma smiling, the food influencer behind Spice and Scoot">
          <div>
            <h1>Riya "Spice" Sharma</h1>
            <p><strong>Food Delivery Influencer</strong> · Mumbai, India</p>
            <p>📸 250K followers · 🎬 800+ reviews · 🍛 1 million meals ordered</p>
          </div>
        </div>
      </section>

      <!-- TASK 4: ChatGPT-style bio -->
      <section aria-labelledby="bio-heading">
        <h2 id="bio-heading">My Story 🍜</h2>
        <p>
          Born in the chaotic, delicious streets of Mumbai, Riya "Spice" Sharma grew up believing that
          every meal tells a story — and every delivery box is a tiny adventure. What started as a
          hobby of filming her late-night <em>biryani</em> unboxings quickly turned into a full-blown
          mission: to taste, rate, and celebrate India's incredible food delivery scene, one order at a time.
        </p>
        <p>
          Today, she's the friendly voice behind <strong>Spice &amp; Scoot</strong>, where she dishes
          out honest reviews, hidden-gem recommendations, and the occasional embarrassing story about
          spilling sambar on her scooter. Whether it's ₹50 street chaat or a ₹5000 fine-dining box,
          Riya believes great food should always be shared — and always reviewed with a smile.
        </p>
      </section>

      <section aria-labelledby="faves-heading">
        <h2 id="faves-heading">My Favourite Dishes ❤️</h2>
        <ul class="faves">
          <li>🍛 Hyderabadi Chicken Biryani</li>
          <li>🥞 Masala Dosa with extra chutney</li>
          <li>🍔 Cheesy Mumbai Vada Pav</li>
          <li>🍜 Kolkata-style Egg Rolls</li>
          <li>🍰 Gulab Jamun (warm, always)</li>
        </ul>
      </section>

      <!-- TASK 2: Semantic contact form -->
      <section aria-labelledby="contact-heading">
        <h2 id="contact-heading">Get In Touch ✉️</h2>
        <p>Collaborations, reviews, or just want to say hi? Drop a message below.</p>

        <form action="#" method="post" onsubmit="event.preventDefault(); alert('Thank you! Your message has been sent.');">
          <fieldset>
            <legend>Contact Details</legend>

            <div class="form-field">
              <label for="name">Your Name</label>
              <input type="text" id="name" name="name"
                     placeholder="e.g. Priya Patel" required>
            </div>

            <div class="form-field">
              <label for="email">Email Address</label>
              <input type="email" id="email" name="email"
                     placeholder="you@example.com" required>
            </div>

            <div class="form-field">
              <label for="message">Short Message</label>
              <textarea id="message" name="message" rows="5"
                        placeholder="Tell me what's on your mind (or your plate)..."
                        required></textarea>
            </div>

            <button type="submit">Send Message</button>
          </fieldset>
        </form>
      </section>

    </div>

  </div>

  <footer>
    <p>© 2025 Spice &amp; Scoot · Made with ❤️ in Mumbai</p>
  </footer>

  <!-- ============================================================
       JavaScript: switchPage() toggles the visible page and
       updates aria-current for accessibility + visual highlight.
       ============================================================ -->
  <script>
    function switchPage(pageId) {
      // 1. Hide all pages
      const pages = document.querySelectorAll('.page');
      pages.forEach(function (page) {
        page.classList.remove('active');
      });

      // 2. Show the requested page
      const targetPage = document.getElementById('page-' + pageId);
      if (targetPage) {
        targetPage.classList.add('active');
      }

      // 3. Update aria-current on the nav buttons
      const navButtons = document.querySelectorAll('nav button');
      navButtons.forEach(function (btn) {
        btn.removeAttribute('aria-current');
      });

      if (pageId === 'home') {
        document.getElementById('navHome').setAttribute('aria-current', 'page');
      } else if (pageId === 'profile') {
        document.getElementById('navProfile').setAttribute('aria-current', 'page');
      }

      // 4. Scroll back to top for a fresh page feel
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  </script>

</body>
</html>
